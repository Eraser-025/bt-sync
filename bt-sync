"""Launcher of the bt-sync root backend (the code is in btsync/backend.py).

-I (isolated mode): this runs as root through pkexec and systemd, so it must
not honour PYTHON* environment variables or the user's site-packages."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True   # never leave __pycache__ in /usr/lib

_here = Path(__file__).resolve().parent
for _lib in (_here.parent / "lib" / "bt-sync", _here):   # installed, source tree
    if (_lib / "btsync" / "__init__.py").is_file():
        sys.path.insert(0, str(_lib))
        break

from btsync.backend import main  # noqa: E402

sys.exit(main())
