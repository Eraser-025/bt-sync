#: btsync/backend.py:59
msgid "This usually means Windows was hibernated or Fast Startup is enabled: in Windows run 'powercfg /h off' from an administrator prompt, then use Shut down (not Restart) before booting Linux."
msgstr "Di solito succede perché Windows è stato ibernato o l'avvio rapido è attivo: in Windows esegui 'powercfg /h off' da un prompt come amministratore, poi usa Arresta il sistema (non Riavvia) prima di avviare Linux."

#: btsync/backend.py:90 btsync/backend.py:758
#, python-brace-format
msgid "unexpected error: {error}"
msgstr "errore imprevisto: {error}"

#: btsync/backend.py:94
#, python-brace-format
msgid "bt-sync: warning: {message}"
msgstr "bt-sync: attenzione: {message}"

#: btsync/backend.py:108
#, python-brace-format
msgid "ignoring invalid {path}: {error}"
msgstr "{path} non valido, ignorato: {error}"

#: btsync/backend.py:145
msgid "this command must be run as root (try: sudo bt-sync ...)."
msgstr "questo comando va eseguito come root (prova: sudo bt-sync ...)."

#: btsync/backend.py:177
msgid "another bt-sync operation is still running; try again in a minute."
msgstr "un'altra operazione di bt-sync è ancora in corso; riprova tra un minuto."

#: btsync/backend.py:227
#, python-brace-format
msgid "lsblk failed: {error}"
msgstr "lsblk non riuscito: {error}"

#: btsync/backend.py:247
#, python-brace-format
msgid "Windows partition not found: no NTFS partition contains {path}."
msgstr "Partizione di Windows non trovata: nessuna partizione NTFS contiene {path}."

#: btsync/backend.py:250
msgid "A BitLocker-encrypted partition was detected: bt-sync cannot read it. Turn off BitLocker (or device encryption) on the Windows system drive."
msgstr "È stata rilevata una partizione cifrata con BitLocker: bt-sync non può leggerla. Disattiva BitLocker (o la crittografia del dispositivo) sull'unità di sistema di Windows."

#: btsync/backend.py:254
msgid "No NTFS partitions were detected at all."
msgstr "Non è stata trovata nessuna partizione NTFS."

#: btsync/backend.py:256
#, python-brace-format
msgid "Some NTFS partitions could not be mounted ({errors})."
msgstr "Alcune partizioni NTFS non sono state montate ({errors})."

#: btsync/backend.py:289
msgid "the Python bindings of hivex are missing: install 'hivex' (Arch) or 'python3-hivex' (Debian, Ubuntu, Fedora)."
msgstr "mancano i binding Python di hivex: installa 'hivex' (Arch) o 'python3-hivex' (Debian, Ubuntu, Fedora)."

#: btsync/backend.py:295
#, python-brace-format
msgid "cannot open the Windows registry {path}: {error}"
msgstr "impossibile aprire il registro di Windows {path}: {error}"

#: btsync/backend.py:301
msgid "unexpected Windows registry layout (SYSTEM\\Select\\Current is missing)."
msgstr "struttura inattesa del registro di Windows (manca SYSTEM\\Select\\Current)."

#: btsync/backend.py:309
#, python-brace-format
msgid "Windows registry key not found: {key}. Has Bluetooth ever been used on this Windows install?"
msgstr "Chiave di registro di Windows non trovata: {key}. Il Bluetooth è mai stato usato su questa installazione di Windows?"

#: btsync/backend.py:315
msgid "no Bluetooth pairing keys in the Windows registry (pair at least one device in Windows first)."
msgstr "nessuna chiave di pairing Bluetooth nel registro di Windows (abbina prima almeno un dispositivo in Windows)."

#: btsync/backend.py:403
#, python-brace-format
msgid "Bluetooth adapter {adapter} is not in the Windows registry."
msgstr "L'adattatore Bluetooth {adapter} non è presente nel registro di Windows."

#: btsync/backend.py:433
#, python-brace-format
msgid "writing the Windows registry failed: {error}"
msgstr "scrittura del registro di Windows non riuscita: {error}"

#: btsync/backend.py:483
#, python-brace-format
msgid "skipping unreadable {path}: {error}"
msgstr "salto {path}, illeggibile: {error}"

#: btsync/backend.py:539
#, python-brace-format
msgid "could not stop bluetooth.service: {error}"
msgstr "impossibile fermare bluetooth.service: {error}"

#: btsync/backend.py:547
#, python-brace-format
msgid "could not restart bluetooth.service, run 'sudo systemctl start bluetooth': {error}"
msgstr "impossibile riavviare bluetooth.service, esegui 'sudo systemctl start bluetooth': {error}"

#: btsync/backend.py:626
#, python-brace-format
msgid "bt-sync: scan failed: {error}"
msgstr "bt-sync: scansione non riuscita: {error}"

#: btsync/backend.py:643 btsync/backend.py:859
#, python-brace-format
msgid "imported into {system}: {device} ({kind})"
msgstr "importato su {system}: {device} ({kind})"

#: btsync/backend.py:660
#, python-brace-format
msgid "exported to Windows: {device} ({kind})"
msgstr "esportato su Windows: {device} ({kind})"

#: btsync/backend.py:667
msgid "Windows is mounted read-only."
msgstr "Windows è montato in sola lettura."

#: btsync/backend.py:669
#, python-brace-format
msgid "Windows is mounted read-only (it is already mounted at {path})."
msgstr "Windows è montato in sola lettura (è già montato in {path})."

#: btsync/backend.py:682
#, python-brace-format
msgid "could not enable the background scan: {error}"
msgstr "impossibile attivare la scansione in background: {error}"

#: btsync/backend.py:685 btsync/gui.py:519
msgid "Background scan enabled."
msgstr "Scansione in background attivata."

#: btsync/backend.py:695
msgid "bt-sync: another operation is running, scan skipped."
msgstr "bt-sync: è in corso un'altra operazione, scansione saltata."

#: btsync/backend.py:697
msgid "Scan completed."
msgstr "Scansione completata."

#: btsync/backend.py:697
msgid "Scan completed with errors."
msgstr "Scansione completata con errori."

#: btsync/backend.py:705 btsync/backend.py:707 btsync/backend.py:713
msgid "invalid request from the GUI."
msgstr "richiesta non valida dalla GUI."

#: btsync/backend.py:749
#, python-brace-format
msgid "{device}: nothing to copy in that direction (already in sync?)."
msgstr "{device}: niente da copiare in quella direzione (già sincronizzato?)."

#: btsync/backend.py:776
msgid "the output contains secret pairing keys: keep it private."
msgstr "l'output contiene chiavi di pairing segrete: non condividerlo."

#: btsync/backend.py:786 btsync/backend.py:848
msgid "this is not a valid bt-sync key backup file."
msgstr "questo non è un file di backup delle chiavi di bt-sync valido."

#: btsync/backend.py:873
#, python-brace-format
msgid "Adapters not present on this computer (skipped): {list}"
msgstr "Adattatori non presenti su questo computer (saltati): {list}"

#: btsync/backend.py:875
#, python-brace-format
msgid "Already present: {n}"
msgstr "Già presenti: {n}"

#: btsync/backend.py:876
msgid "New"
msgstr "Nuova"

#: btsync/backend.py:876
msgid "Different from this computer"
msgstr "Diversa da questo computer"

#: btsync/backend.py:880
msgid "Dry run: nothing was changed."
msgstr "Prova a vuoto: non è stato modificato nulla."

#: btsync/backend.py:882
msgid "Keys that differ were kept; use --overwrite to replace them."
msgstr "Le chiavi diverse sono state mantenute; usa --overwrite per sostituirle."

#: btsync/backend.py:886 btsync/backend.py:979
#, python-brace-format
msgid "error: {message}"
msgstr "errore: {message}"

#: btsync/backend.py:893
#, python-brace-format
msgid "on Windows, missing on {system}"
msgstr "presente su Windows, manca su {system}"

#: btsync/backend.py:894
#, python-brace-format
msgid "on {system}, missing on Windows"
msgstr "presente su {system}, manca su Windows"

#: btsync/backend.py:895
msgid "DIFFERENT keys on the two systems"
msgstr "chiavi DIVERSE sui due sistemi"

#: btsync/backend.py:901
msgid "the Windows key is newer"
msgstr "la chiave di Windows è più recente"

#: btsync/backend.py:903
#, python-brace-format
msgid "the {system} key is newer"
msgstr "la chiave di {system} è più recente"

#: btsync/backend.py:914 btsync/backend.py:957
msgid "Everything is in sync."
msgstr "Tutto sincronizzato."

#: btsync/backend.py:927
msgid "skip"
msgstr "salta"

#: btsync/backend.py:927
msgid "ignore from now on"
msgstr "ignora d'ora in poi"

#: btsync/backend.py:929
#, python-brace-format
msgid "import into {system}"
msgstr "importa su {system}"

#: btsync/backend.py:932
msgid "export to Windows"
msgstr "esporta su Windows"

#: btsync/backend.py:934
msgid "(Windows is mounted read-only: cannot export)"
msgstr "(Windows è montato in sola lettura: impossibile esportare)"

#: btsync/backend.py:975
#, python-brace-format
msgid "backup of the Windows registry saved to {path}"
msgstr "backup del registro di Windows salvato in {path}"

#: btsync/backend.py:1012
#, python-brace-format
msgid "bt-sync: error: {message}"
msgstr "bt-sync: errore: {message}"

#: btsync/backend.py:1015
msgid "Aborted, nothing was changed."
msgstr "Interrotto, non è stato modificato nulla."

