msgstr "Aucune analyse disponible"

#: btsync/gui.py
msgid ""
"The background scan has not run yet. If this persists, make sure it is "
"enabled:"
msgstr ""
"L'analyse en arrière-plan n'a pas encore été exécutée. Si cela persiste, "
"vérifiez qu'elle est activée :"

#: btsync/gui.py
#, python-brace-format
msgid "{n} device to sync"
msgid_plural "{n} devices to sync"
msgstr[0] "{n} appareil à synchroniser"
msgstr[1] "{n} appareils à synchroniser"

#: btsync/gui.py
msgid "everything in sync"
msgstr "tout est synchronisé"

#: btsync/gui.py
#, python-brace-format
msgid "To sync: {devices}"
msgstr "À synchroniser : {devices}"

#: btsync/gui.py
msgid "different keys"
msgstr "clés différentes"

#: btsync/gui.py
msgid "newer key"
msgstr "clé plus récente"

#: btsync/gui.py
msgid "older key"
msgstr "clé plus ancienne"

#: btsync/gui.py
#, python-brace-format
msgid "{kind} key changed on Windows: {wtime}, on {system}: {ltime}"
msgstr "Clé {kind} modifiée sur Windows : {wtime}, sur {system} : {ltime}"

#: btsync/gui.py
msgid ""
"Cannot tell which key is newer: copy from the system where you paired the "
"device last."
msgstr ""
"Impossible de savoir quelle clé est la plus récente : copiez depuis le "
"système sur lequel vous avez appairé l'appareil en dernier."

#: btsync/gui.py
msgid "only here"
msgstr "uniquement ici"

#: btsync/gui.py
