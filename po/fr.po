#: btsync/backend.py
msgid ""
"This usually means Windows was hibernated or Fast Startup is enabled: in "
"Windows run 'powercfg /h off' from an administrator prompt, then use Shut "
"down (not Restart) before booting Linux."
msgstr ""
"Cela signifie généralement que Windows a été mis en veille prolongée ou que "
"le démarrage rapide est activé : dans Windows, exécutez 'powercfg /h off' "
"dans une invite de commandes administrateur, puis utilisez Arrêter (et non "
"Redémarrer) avant de démarrer Linux."

#: btsync/backend.py
#, python-brace-format
msgid "unexpected error: {error}"
msgstr "erreur inattendue : {error}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: warning: {message}"
msgstr "bt-sync : avertissement : {message}"

#: btsync/backend.py
#, python-brace-format
msgid "ignoring invalid {path}: {error}"
msgstr "{path} invalide, ignoré : {error}"

#: btsync/backend.py
msgid "this command must be run as root (try: sudo bt-sync ...)."
msgstr ""
"cette commande doit être exécutée en tant que root (essayez : sudo bt-"
"sync ...)."

#: btsync/backend.py
msgid "another bt-sync operation is still running; try again in a minute."
msgstr ""
"une autre opération bt-sync est toujours en cours ; réessayez dans une "
"minute."

#: btsync/backend.py
#, python-brace-format
msgid "lsblk failed: {error}"
msgstr "échec de lsblk : {error}"

#: btsync/backend.py
#, python-brace-format
msgid "Windows partition not found: no NTFS partition contains {path}."
msgstr ""
"Partition Windows introuvable : aucune partition NTFS ne contient {path}."

#: btsync/backend.py
msgid ""
"A BitLocker-encrypted partition was detected: bt-sync cannot read it. Turn "
"off BitLocker (or device encryption) on the Windows system drive."
msgstr ""
"Une partition chiffrée avec BitLocker a été détectée : bt-sync ne peut pas "
"la lire. Désactivez BitLocker (ou le chiffrement de l'appareil) sur le "
"lecteur système de Windows."

#: btsync/backend.py
msgid "No NTFS partitions were detected at all."
msgstr "Aucune partition NTFS n'a été détectée."

#: btsync/backend.py
#, python-brace-format
msgid "Some NTFS partitions could not be mounted ({errors})."
msgstr "Certaines partitions NTFS n'ont pas pu être montées ({errors})."

#: btsync/backend.py
msgid ""
"the Python bindings of hivex are missing: install 'hivex' (Arch) or 'python3-"
"hivex' (Debian, Ubuntu, Fedora)."
msgstr ""
"les liaisons Python de hivex sont absentes : installez 'hivex' (Arch) ou "
"'python3-hivex' (Debian, Ubuntu, Fedora)."

#: btsync/backend.py
#, python-brace-format
msgid "cannot open the Windows registry {path}: {error}"
msgstr "impossible d'ouvrir le registre Windows {path} : {error}"

#: btsync/backend.py
msgid ""
"unexpected Windows registry layout (SYSTEM\\Select\\Current is missing)."
msgstr ""
"structure inattendue du registre Windows (SYSTEM\\Select\\Current est "
"absent)."

#: btsync/backend.py
#, python-brace-format
msgid ""
"Windows registry key not found: {key}. Has Bluetooth ever been used on this "
"Windows install?"
msgstr ""
"Clé de registre Windows introuvable : {key}. Le Bluetooth a-t-il déjà été "
"utilisé sur cette installation de Windows ?"

#: btsync/backend.py
msgid ""
"no Bluetooth pairing keys in the Windows registry (pair at least one device "
"in Windows first)."
msgstr ""
"aucune clé d'appairage Bluetooth dans le registre Windows (appairez d'abord "
"au moins un appareil dans Windows)."

#: btsync/backend.py
#, python-brace-format
msgid "Bluetooth adapter {adapter} is not in the Windows registry."
msgstr "L'adaptateur Bluetooth {adapter} n'est pas dans le registre Windows."

#: btsync/backend.py
#, python-brace-format
msgid "writing the Windows registry failed: {error}"
msgstr "échec de l'écriture du registre Windows : {error}"

#: btsync/backend.py
#, python-brace-format
msgid "skipping unreadable {path}: {error}"
msgstr "{path} illisible, ignoré : {error}"

#: btsync/backend.py
#, python-brace-format
msgid "could not stop bluetooth.service: {error}"
msgstr "impossible d'arrêter bluetooth.service : {error}"

#: btsync/backend.py
#, python-brace-format
msgid ""
"could not restart bluetooth.service, run 'sudo systemctl start bluetooth': "
"{error}"
msgstr ""
"impossible de redémarrer bluetooth.service, exécutez 'sudo systemctl start "
"bluetooth' : {error}"

#: btsync/backend.py
#, python-brace-format
