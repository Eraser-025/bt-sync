msgstr "partiellement synchronisé"

#: btsync/gui.py
msgid "in sync"
msgstr "synchronisé"

#: btsync/gui.py
msgid "Could not read Windows:"
msgstr "Impossible de lire Windows :"

#: btsync/gui.py
msgid ""
"Linux and Windows use different Bluetooth adapters (different adapter "
"addresses): nothing can be synced."
msgstr ""
"Linux et Windows utilisent des adaptateurs Bluetooth différents (adresses "
"d'adaptateur différentes) : rien ne peut être synchronisé."

#: btsync/gui.py
#, python-brace-format
msgid "Last scan: {time}"
msgstr "Dernière analyse : {time}"

#: btsync/gui.py
#, python-brace-format
msgid ""
"{devices}: the key on {system} is newer. You probably want to copy in the "
"other direction."
msgstr ""
"{devices} : la clé sur {system} est plus récente. Vous voulez probablement "
"copier dans l'autre sens."

#: btsync/gui.py
msgid "The selected key is the newer one: copying it is probably right."
msgstr ""
"La clé sélectionnée est la plus récente : la copier est probablement le bon "
"choix."

#: btsync/gui.py
msgid "Cannot start a scan"
msgstr "Impossible de lancer l'analyse"

#: btsync/gui.py
#, python-brace-format
