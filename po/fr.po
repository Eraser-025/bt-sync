msgstr ""
"L'analyse en arrière-plan n'est pas activée : les listes d'appareils ne sont "
"donc pas mises à jour."

#: btsync/gui.py
msgid "Cannot change the login autostart:"
msgstr "Impossible de modifier le démarrage automatique à la connexion :"

#: btsync/gui.py
#, python-brace-format
