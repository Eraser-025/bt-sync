msgstr ""
"Impossible de lancer pkexec. polkit est-il installé et un agent "
"d'authentification polkit est-il actif ?"

#: btsync/gui.py
msgid "Authentication cancelled or not authorized"
msgstr "Authentification annulée ou non autorisée"

#: btsync/gui.py
#, python-brace-format
msgid "Unexpected answer from {helper} (exit code {code})."
msgstr "Réponse inattendue de {helper} (code de sortie {code})."

#: btsync/gui.py
msgid "Working…"
msgstr "En cours…"

#: btsync/gui.py
#, python-brace-format
msgid ""
"The keys of {devices} differ between the two systems.\n"
"The ones on {system} will be overwritten."
msgstr ""
"Les clés de {devices} diffèrent entre les deux systèmes.\n"
"Celles de {system} seront écrasées."

#: btsync/gui.py
#, python-brace-format
msgid ""
"Careful: for {devices} the key you are about to overwrite is the newer one."
msgstr ""
"Attention : pour {devices}, la clé que vous allez écraser est la plus "
"récente."

#: btsync/gui.py
msgid "Overwrite the keys?"
msgstr "Écraser les clés ?"

#: btsync/gui.py
msgid "Continue?"
msgstr "Continuer ?"

#: btsync/gui.py
#, python-brace-format
msgid ""
"The pairing keys of {devices} will be deleted from {system}. The device will "
"have to be paired again there, or you can copy the key from the other system."
msgstr ""
"Les clés d'appairage de {devices} seront supprimées de {system}. Il faudra y "
"appairer à nouveau l'appareil, ou copier la clé depuis l'autre système."

#: btsync/gui.py
msgid ""
"Windows may still list the device in its Bluetooth settings: remove it there "
"too if needed. A backup of the Windows registry is made first."
msgstr ""
"Windows peut continuer à afficher l'appareil dans ses paramètres Bluetooth : "
"supprimez-le aussi à cet endroit si nécessaire. Une sauvegarde du registre "
"Windows est faite au préalable."

#: btsync/gui.py
msgid "Bluetooth will restart for a moment."
msgstr "Le Bluetooth va redémarrer un instant."

#: btsync/gui.py
msgid "Delete the pairing?"
msgstr "Supprimer l'appairage ?"

#: btsync/gui.py
msgid "Delete"
msgstr "Supprimer"

