msgstr ""
"{devices} のキーは 2 つのシステムで異なります。\n"
"{system} のキーが上書きされます。"

#: btsync/gui.py:832
#, python-brace-format
msgid "Careful: for {devices} the key you are about to overwrite is the newer one."
msgstr "注意: {devices} では、上書きしようとしているキーの方が新しいです。"

