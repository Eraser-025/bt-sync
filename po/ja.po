msgstr "今すぐ更新"

#: btsync/gui.py:468
msgid "Settings…"
msgstr "設定…"

#: btsync/gui.py:471
msgid "Quit"
msgstr "終了"

#: btsync/gui.py:507
msgid "The background scan is not enabled, so the device lists are not updated."
msgstr "バックグラウンドスキャンが有効になっていないため、デバイス一覧は更新されません。"

#: btsync/gui.py:538
msgid "Cannot change the login autostart:"
msgstr "ログイン時の自動起動を変更できません:"

#: btsync/gui.py:549
#, python-brace-format
msgid "Could not open the browser: {url}"
msgstr "ブラウザーを開けませんでした: {url}"

#: btsync/gui.py:557
msgid "No scan available yet"
msgstr "まだスキャン結果がありません"

#: btsync/gui.py:559
msgid "The background scan has not run yet. If this persists, make sure it is enabled:"
msgstr "バックグラウンドスキャンがまだ実行されていません。この状態が続く場合は、有効になっているか確認してください:"

#: btsync/gui.py:594
#, python-brace-format
msgid "{n} device to sync"
msgid_plural "{n} devices to sync"
msgstr[0] "同期が必要なデバイス: {n} 台"

#: btsync/gui.py:596
msgid "everything in sync"
msgstr "すべて同期済み"

#: btsync/gui.py:600
#, python-brace-format
msgid "To sync: {devices}"
msgstr "同期が必要: {devices}"

#: btsync/gui.py:631
msgid "different keys"
msgstr "キーが異なる"

#: btsync/gui.py:633
msgid "newer key"
msgstr "新しい方のキー"

#: btsync/gui.py:635
msgid "older key"
msgstr "古い方のキー"

#: btsync/gui.py:637
#, python-brace-format
msgid "{kind} key changed on Windows: {wtime}, on {system}: {ltime}"
msgstr "{kind} キーの変更日時 — Windows: {wtime}、{system}: {ltime}"

#: btsync/gui.py:645
msgid "Cannot tell which key is newer: copy from the system where you paired the device last."
msgstr "どちらのキーが新しいか判断できません。最後にデバイスをペアリングしたシステムからコピーしてください。"

#: btsync/gui.py:648
msgid "only here"
msgstr "ここだけ"

#: btsync/gui.py:650
