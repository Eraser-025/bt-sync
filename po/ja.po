msgstr "今すぐ両方のシステムを再スキャン"

#: btsync/gui.py:370
msgid "Enable now"
msgstr "今すぐ有効にする"

#: btsync/gui.py:412
msgid "✔ in sync     → only on one system     ⚠ different keys (★ = newer key)"
msgstr "✔ 同期済み     → 片方のシステムのみ     ⚠ キーが異なる (★ = 新しい方のキー)"

#: btsync/gui.py:418
msgid "Archive: never sync these and don't notify me"
msgstr "アーカイブ: これらは同期せず、通知もしない"

#: btsync/gui.py:422
msgid "Archive selected ↓"
msgstr "選択をアーカイブ ↓"

#: btsync/gui.py:423
msgid "↑ Restore selected"
msgstr "↑ 選択を元に戻す"

#: btsync/gui.py:440
msgid "Enjoying bt-sync? Buy me a 1UP!"
msgstr "bt-sync を気に入ってくれましたか？ 1UP をおごってください！"

#: btsync/gui.py:442
msgid "Support me ☕"
msgstr "応援する ☕"

#: btsync/gui.py:454
msgid "to Windows"
msgstr "Windows へ"

#: btsync/gui.py:455
#, python-brace-format
