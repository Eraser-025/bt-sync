msgstr "一部同期済み"

#: btsync/gui.py:652
msgid "in sync"
msgstr "同期済み"

#: btsync/gui.py:674
msgid "Could not read Windows:"
msgstr "Windows を読み取れませんでした:"

#: btsync/gui.py:677
msgid "Linux and Windows use different Bluetooth adapters (different adapter addresses): nothing can be synced."
msgstr "Linux と Windows で異なる Bluetooth アダプターを使っています (アダプターのアドレスが異なります)。同期できるものはありません。"

#: btsync/gui.py:682
#, python-brace-format
msgid "Last scan: {time}"
msgstr "最終スキャン: {time}"

#: btsync/gui.py:706
#, python-brace-format
msgid "{devices}: the key on {system} is newer. You probably want to copy in the other direction."
msgstr "{devices}: {system} のキーの方が新しいです。おそらく逆方向にコピーするべきです。"

#: btsync/gui.py:710
msgid "The selected key is the newer one: copying it is probably right."
msgstr "選択したキーの方が新しいです。これをコピーするのがおそらく正解です。"

#: btsync/gui.py:744
msgid "Cannot start a scan"
msgstr "スキャンを開始できません"

#: btsync/gui.py:745
#, python-brace-format
