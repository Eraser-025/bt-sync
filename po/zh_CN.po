msgstr "bt-sync 密钥备份"

#: btsync/gui.py:883
#, python-brace-format
msgid "Cannot write {path}: {error}"
msgstr "无法写入 {path}：{error}"

#: btsync/gui.py:887
#, python-brace-format
msgid "Exported {n} pairing key to:"
msgid_plural "Exported {n} pairing keys to:"
msgstr[0] "已将 {n} 个配对密钥导出到："

