msgstr "此桌面没有系统托盘"

#: btsync/gui.py:230
msgid "Show desktop notifications"
msgstr "显示桌面通知"

#: btsync/gui.py:237
msgid "Pairing keys backup"
msgstr "配对密钥备份"

#: btsync/gui.py:239
msgid "Save the pairing keys of this Linux system to a file and restore them later, for example after reinstalling Linux or on another Linux system installed on this computer."
msgstr "将此 Linux 系统的配对密钥保存到文件中，以后再恢复，例如重装 Linux 之后，或在本机安装的另一个 Linux 系统上。"

#: btsync/gui.py:245
msgid "Export keys…"
msgstr "导出密钥…"

#: btsync/gui.py:246
msgid "Import keys…"
msgstr "导入密钥…"

#: btsync/gui.py:253 btsync/gui.py:889
msgid "The file contains secret keys: keep it private."
msgstr "该文件包含机密密钥：请妥善保管。"

#: btsync/gui.py:346
msgid "Bluetooth devices"
msgstr "蓝牙设备"

#: btsync/gui.py:348
msgid "Refresh"
msgstr "刷新"

#: btsync/gui.py:349
msgid "Rescan both systems now"
msgstr "立即重新扫描两个系统"

#: btsync/gui.py:370
msgid "Enable now"
msgstr "立即启用"

#: btsync/gui.py:412
msgid "✔ in sync     → only on one system     ⚠ different keys (★ = newer key)"
msgstr "✔ 已同步     → 仅在一个系统上     ⚠ 密钥不同（★ = 较新的密钥）"

#: btsync/gui.py:418
msgid "Archive: never sync these and don't notify me"
msgstr "归档：不同步这些设备，也不通知我"

#: btsync/gui.py:422
msgid "Archive selected ↓"
msgstr "归档所选 ↓"

#: btsync/gui.py:423
msgid "↑ Restore selected"
msgstr "↑ 恢复所选"

#: btsync/gui.py:440
msgid "Enjoying bt-sync? Buy me a 1UP!"
msgstr "喜欢 bt-sync 吗？请我吃个 1UP 蘑菇吧！"

#: btsync/gui.py:442
msgid "Support me ☕"
msgstr "支持我 ☕"

#: btsync/gui.py:454
msgid "to Windows"
msgstr "到 Windows"

#: btsync/gui.py:455
#, python-brace-format
msgid "to {system}"
msgstr "到 {system}"

#: btsync/gui.py:456
#, python-brace-format
msgid "Copy the selected devices from {system} to Windows"
msgstr "将所选设备从 {system} 复制到 Windows"

#: btsync/gui.py:458
#, python-brace-format
msgid "Copy the selected devices from Windows to {system}"
msgstr "将所选设备从 Windows 复制到 {system}"

#: btsync/gui.py:465
msgid "Open Bluetooth Sync"
msgstr "打开 Bluetooth Sync"

#: btsync/gui.py:466
msgid "Refresh now"
msgstr "立即刷新"

#: btsync/gui.py:468
msgid "Settings…"
msgstr "设置…"

#: btsync/gui.py:471
msgid "Quit"
msgstr "退出"

#: btsync/gui.py:507
msgid "The background scan is not enabled, so the device lists are not updated."
msgstr "后台扫描未启用，因此设备列表不会更新。"

#: btsync/gui.py:538
msgid "Cannot change the login autostart:"
msgstr "无法更改登录时自动启动："

#: btsync/gui.py:549
#, python-brace-format
msgid "Could not open the browser: {url}"
msgstr "无法打开浏览器：{url}"

#: btsync/gui.py:557
msgid "No scan available yet"
msgstr "尚无扫描结果"

#: btsync/gui.py:559
msgid "The background scan has not run yet. If this persists, make sure it is enabled:"
msgstr "后台扫描尚未运行。如果一直如此，请确认已启用："

#: btsync/gui.py:594
#, python-brace-format
msgid "{n} device to sync"
msgid_plural "{n} devices to sync"
msgstr[0] "{n} 个设备待同步"

#: btsync/gui.py:596
msgid "everything in sync"
msgstr "全部已同步"

#: btsync/gui.py:600
#, python-brace-format
msgid "To sync: {devices}"
msgstr "待同步：{devices}"

#: btsync/gui.py:631
msgid "different keys"
msgstr "密钥不同"

#: btsync/gui.py:633
msgid "newer key"
msgstr "较新的密钥"

#: btsync/gui.py:635
msgid "older key"
msgstr "较旧的密钥"

#: btsync/gui.py:637
#, python-brace-format
msgid "{kind} key changed on Windows: {wtime}, on {system}: {ltime}"
msgstr "{kind} 密钥修改时间 — Windows：{wtime}，{system}：{ltime}"

#: btsync/gui.py:645
msgid "Cannot tell which key is newer: copy from the system where you paired the device last."
msgstr "无法判断哪个密钥更新：请从最后一次配对该设备的系统复制。"

#: btsync/gui.py:648
msgid "only here"
msgstr "仅在此处"

#: btsync/gui.py:650
msgid "partially synced"
msgstr "部分同步"

#: btsync/gui.py:652
msgid "in sync"
msgstr "已同步"

#: btsync/gui.py:674
msgid "Could not read Windows:"
msgstr "无法读取 Windows："

#: btsync/gui.py:677
msgid "Linux and Windows use different Bluetooth adapters (different adapter addresses): nothing can be synced."
msgstr "Linux 和 Windows 使用的蓝牙适配器不同（适配器地址不同）：无法同步。"

#: btsync/gui.py:682
#, python-brace-format
msgid "Last scan: {time}"
msgstr "上次扫描：{time}"

#: btsync/gui.py:706
#, python-brace-format
msgid "{devices}: the key on {system} is newer. You probably want to copy in the other direction."
msgstr "{devices}：{system} 上的密钥更新。你可能需要反方向复制。"

#: btsync/gui.py:710
msgid "The selected key is the newer one: copying it is probably right."
msgstr "所选密钥是较新的：复制它可能是正确的。"

#: btsync/gui.py:744
msgid "Cannot start a scan"
msgstr "无法开始扫描"

#: btsync/gui.py:745
#, python-brace-format
msgid "Cannot request a scan ({error}). Try:"
msgstr "无法请求扫描（{error}）。试试："

#: btsync/gui.py:751
msgid "Scanning…"
msgstr "正在扫描…"

#: btsync/gui.py:758
msgid "The scan did not answer"
msgstr "扫描没有响应"

#: btsync/gui.py:763
msgid "The scan service did not answer. Make sure it is enabled:"
msgstr "扫描服务没有响应。请确认已启用："

#: btsync/gui.py:780
msgid "Could not start pkexec. Is polkit installed and is a polkit authentication agent running?"
msgstr "无法启动 pkexec。是否已安装 polkit 并运行了 polkit 认证代理？"

#: btsync/gui.py:792
msgid "Authentication cancelled or not authorized"
msgstr "认证已取消或未获授权"

#: btsync/gui.py:798
#, python-brace-format
msgid "Unexpected answer from {helper} (exit code {code})."
msgstr "{helper} 返回了意外结果（退出码 {code}）。"

#: btsync/gui.py:814
msgid "Working…"
msgstr "处理中…"

#: btsync/gui.py:827
#, python-brace-format
msgid ""
"The keys of {devices} differ between the two systems.\n"
"The ones on {system} will be overwritten."
msgstr ""
"{devices} 的密钥在两个系统上不同。\n"
"{system} 上的密钥将被覆盖。"

#: btsync/gui.py:832
#, python-brace-format
msgid "Careful: for {devices} the key you are about to overwrite is the newer one."
msgstr "注意：对于 {devices}，你将要覆盖的是较新的密钥。"

#: btsync/gui.py:835
msgid "Overwrite the keys?"
msgstr "覆盖密钥？"

#: btsync/gui.py:836
msgid "Continue?"
msgstr "继续吗？"

#: btsync/gui.py:850 btsync/gui.py:854 btsync/gui.py:957 btsync/gui.py:961
msgid "Done:"
msgstr "已完成："

