#, python-brace-format
msgid "{n} key is different from the one on this computer:"
msgid_plural "{n} keys are different from the ones on this computer:"
msgstr[0] "{n} 个密钥与本机上的不同："

#: btsync/gui.py:937
msgid "Bluetooth will restart for a moment."
msgstr "蓝牙将短暂重启。"

#: btsync/gui.py:939
msgid "Import new keys only"
msgstr "仅导入新密钥"

#: btsync/gui.py:941
msgid "Import and overwrite"
msgstr "导入并覆盖"
