#: btsync/backend.py:59
msgid "This usually means Windows was hibernated or Fast Startup is enabled: in Windows run 'powercfg /h off' from an administrator prompt, then use Shut down (not Restart) before booting Linux."
msgstr "Обычно это значит, что Windows была переведена в гибернацию или включён быстрый запуск: в Windows выполните 'powercfg /h off' в командной строке от имени администратора и используйте «Завершение работы» (а не «Перезагрузку») перед загрузкой Linux."

#: btsync/backend.py:90 btsync/backend.py:758
#, python-brace-format
msgid "unexpected error: {error}"
msgstr "непредвиденная ошибка: {error}"

#: btsync/backend.py:94
#, python-brace-format
msgid "bt-sync: warning: {message}"
msgstr "bt-sync: предупреждение: {message}"

#: btsync/backend.py:108
#, python-brace-format
msgid "ignoring invalid {path}: {error}"
msgstr "некорректный файл {path} пропущен: {error}"

#: btsync/backend.py:145
msgid "this command must be run as root (try: sudo bt-sync ...)."
msgstr "эту команду нужно запускать от root (попробуйте: sudo bt-sync ...)."

#: btsync/backend.py:177
msgid "another bt-sync operation is still running; try again in a minute."
msgstr "другая операция bt-sync ещё выполняется; повторите попытку через минуту."

