#: btsync/backend.py
msgid ""
"This usually means Windows was hibernated or Fast Startup is enabled: in "
"Windows run 'powercfg /h off' from an administrator prompt, then use Shut "
"down (not Restart) before booting Linux."
msgstr ""
"Обычно это значит, что Windows была переведена в гибернацию или включён "
"быстрый запуск: в Windows выполните 'powercfg /h off' в командной строке от "
"имени администратора и используйте «Завершение работы» (а не «Перезагрузку») "
"перед загрузкой Linux."

#: btsync/backend.py
#, python-brace-format
msgid "unexpected error: {error}"
msgstr "непредвиденная ошибка: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: warning: {message}"
msgstr "bt-sync: предупреждение: {message}"

#: btsync/backend.py
#, python-brace-format
msgid "ignoring invalid {path}: {error}"
msgstr "некорректный файл {path} пропущен: {error}"

#: btsync/backend.py
msgid "this command must be run as root (try: sudo bt-sync ...)."
msgstr "эту команду нужно запускать от root (попробуйте: sudo bt-sync ...)."

#: btsync/backend.py
msgid "another bt-sync operation is still running; try again in a minute."
msgstr ""
"другая операция bt-sync ещё выполняется; повторите попытку через минуту."

#: btsync/backend.py
#, python-brace-format
msgid "lsblk failed: {error}"
msgstr "ошибка lsblk: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "Windows partition not found: no NTFS partition contains {path}."
msgstr "Раздел Windows не найден: ни один раздел NTFS не содержит {path}."

#: btsync/backend.py
msgid ""
"A BitLocker-encrypted partition was detected: bt-sync cannot read it. Turn "
"off BitLocker (or device encryption) on the Windows system drive."
msgstr ""
"Обнаружен раздел, зашифрованный BitLocker: bt-sync не может его прочитать. "
"Отключите BitLocker (или шифрование устройства) на системном диске Windows."

#: btsync/backend.py
msgid "No NTFS partitions were detected at all."
msgstr "Разделы NTFS не обнаружены."

#: btsync/backend.py
#, python-brace-format
msgid "Some NTFS partitions could not be mounted ({errors})."
msgstr "Не удалось смонтировать некоторые разделы NTFS ({errors})."

#: btsync/backend.py
msgid ""
"the Python bindings of hivex are missing: install 'hivex' (Arch) or 'python3-"
"hivex' (Debian, Ubuntu, Fedora)."
msgstr ""
"отсутствуют привязки Python для hivex: установите 'hivex' (Arch) или "
"'python3-hivex' (Debian, Ubuntu, Fedora)."

#: btsync/backend.py
#, python-brace-format
msgid "cannot open the Windows registry {path}: {error}"
msgstr "не удаётся открыть реестр Windows {path}: {error}"

#: btsync/backend.py
msgid ""
"unexpected Windows registry layout (SYSTEM\\Select\\Current is missing)."
msgstr ""
"неожиданная структура реестра Windows (отсутствует SYSTEM\\Select\\Current)."

#: btsync/backend.py
#, python-brace-format
msgid ""
"Windows registry key not found: {key}. Has Bluetooth ever been used on this "
"Windows install?"
msgstr ""
"Раздел реестра Windows не найден: {key}. Использовался ли Bluetooth в этой "
"установке Windows?"

#: btsync/backend.py
msgid ""
"no Bluetooth pairing keys in the Windows registry (pair at least one device "
"in Windows first)."
msgstr ""
"в реестре Windows нет ключей сопряжения Bluetooth (сначала выполните "
"сопряжение хотя бы одного устройства в Windows)."

#: btsync/backend.py
#, python-brace-format
msgid "Bluetooth adapter {adapter} is not in the Windows registry."
msgstr "Адаптера Bluetooth {adapter} нет в реестре Windows."

#: btsync/backend.py
#, python-brace-format
msgid "writing the Windows registry failed: {error}"
msgstr "не удалось записать реестр Windows: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "skipping unreadable {path}: {error}"
msgstr "пропуск нечитаемого файла {path}: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "could not stop bluetooth.service: {error}"
msgstr "не удалось остановить bluetooth.service: {error}"

#: btsync/backend.py
#, python-brace-format
msgid ""
"could not restart bluetooth.service, run 'sudo systemctl start bluetooth': "
"{error}"
msgstr ""
"не удалось перезапустить bluetooth.service, выполните 'sudo systemctl start "
"bluetooth': {error}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: scan failed: {error}"
msgstr "bt-sync: сканирование не удалось: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "imported into {system}: {device} ({kind})"
msgstr "импортировано в {system}: {device} ({kind})"

#: btsync/backend.py
#, python-brace-format
msgid "exported to Windows: {device} ({kind})"
msgstr "экспортировано в Windows: {device} ({kind})"

#: btsync/backend.py
msgid "Windows is mounted read-only."
msgstr "Windows смонтирована только для чтения."

#: btsync/backend.py
#, python-brace-format
msgid "Windows is mounted read-only (it is already mounted at {path})."
msgstr ""
"Windows смонтирована только для чтения (она уже смонтирована в {path})."

#: btsync/backend.py
#, python-brace-format
msgid "could not enable the background scan: {error}"
msgstr "не удалось включить фоновое сканирование: {error}"

#: btsync/backend.py btsync/gui.py
msgid "Background scan enabled."
msgstr "Фоновое сканирование включено."

#: btsync/backend.py
msgid "bt-sync: another operation is running, scan skipped."
msgstr "bt-sync: выполняется другая операция, сканирование пропущено."

#: btsync/backend.py
msgid "Scan completed."
msgstr "Сканирование завершено."

#: btsync/backend.py
msgid "Scan completed with errors."
msgstr "Сканирование завершено с ошибками."

#: btsync/backend.py
msgid "invalid request from the GUI."
msgstr "недопустимый запрос от интерфейса."

#: btsync/backend.py
#, python-brace-format
msgid "{device}: nothing to copy in that direction (already in sync?)."
msgstr ""
"{device}: в этом направлении нечего копировать (уже синхронизировано?)."

#: btsync/backend.py
msgid "the output contains secret pairing keys: keep it private."
msgstr "вывод содержит секретные ключи сопряжения: никому его не передавайте."

#: btsync/backend.py
msgid "this is not a valid bt-sync key backup file."
msgstr "это не корректный файл резервной копии ключей bt-sync."

#: btsync/backend.py
#, python-brace-format
msgid "Adapters not present on this computer (skipped): {list}"
msgstr "Адаптеры, отсутствующие на этом компьютере (пропущены): {list}"

#: btsync/backend.py
#, python-brace-format
msgid "Already present: {n}"
msgstr "Уже есть: {n}"

#: btsync/backend.py
msgid "New"
msgstr "Новый"

#: btsync/backend.py
msgid "Different from this computer"
msgstr "Отличается от этого компьютера"

#: btsync/backend.py
msgid "Dry run: nothing was changed."
msgstr "Пробный запуск: ничего не изменено."

#: btsync/backend.py
msgid "Keys that differ were kept; use --overwrite to replace them."
msgstr ""
"Отличающиеся ключи сохранены; используйте --overwrite, чтобы заменить их."

#: btsync/backend.py
#, python-brace-format
msgid "error: {message}"
msgstr "ошибка: {message}"

#: btsync/backend.py
#, python-brace-format
msgid "on Windows, missing on {system}"
msgstr "есть в Windows, нет в {system}"

#: btsync/backend.py
#, python-brace-format
msgid "on {system}, missing on Windows"
msgstr "есть в {system}, нет в Windows"

#: btsync/backend.py
msgid "DIFFERENT keys on the two systems"
msgstr "РАЗНЫЕ ключи в двух системах"

#: btsync/backend.py
msgid "the Windows key is newer"
msgstr "ключ Windows новее"

#: btsync/backend.py
#, python-brace-format
msgid "the {system} key is newer"
msgstr "ключ {system} новее"

#: btsync/backend.py
msgid "Everything is in sync."
msgstr "Всё синхронизировано."

#: btsync/backend.py
msgid "skip"
msgstr "пропустить"

#: btsync/backend.py
msgid "ignore from now on"
msgstr "больше не спрашивать"

#: btsync/backend.py
#, python-brace-format
msgid "import into {system}"
msgstr "импортировать в {system}"

#: btsync/backend.py
msgid "export to Windows"
msgstr "экспортировать в Windows"

#: btsync/backend.py
msgid "(Windows is mounted read-only: cannot export)"
msgstr "(Windows смонтирована только для чтения: экспорт невозможен)"

#: btsync/backend.py
#, python-brace-format
msgid "backup of the Windows registry saved to {path}"
msgstr "резервная копия реестра Windows сохранена в {path}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: error: {message}"
msgstr "bt-sync: ошибка: {message}"

#: btsync/backend.py
msgid "Aborted, nothing was changed."
msgstr "Прервано, ничего не изменено."

#: btsync/gui.py
msgid "Settings"
msgstr "Настройки"

#: btsync/gui.py
msgid "General"
msgstr "Общие"

#: btsync/gui.py
#, python-brace-format
msgid "System default ({language})"
msgstr "Как в системе ({language})"

#: btsync/gui.py
msgid "Language:"
msgstr "Язык:"

#: btsync/gui.py
msgid "Start in tray at login"
msgstr "Запускать в трее при входе в систему"

#: btsync/gui.py
msgid "No system tray available on this desktop"
msgstr "На этом рабочем столе нет системного трея"

#: btsync/gui.py
msgid "Show desktop notifications"
msgstr "Показывать уведомления"

#: btsync/gui.py
msgid "Pairing keys backup"
msgstr "Резервная копия ключей сопряжения"

#: btsync/gui.py
msgid ""
"Save the pairing keys of this Linux system to a file and restore them later, "
"for example after reinstalling Linux or on another Linux system installed on "
"this computer."
msgstr ""
"Сохраните ключи сопряжения этой системы Linux в файл и восстановите их "
"позже, например после переустановки Linux или в другой системе Linux на этом "
"компьютере."

#: btsync/gui.py
msgid "Export keys…"
msgstr "Экспорт ключей…"

#: btsync/gui.py
msgid "Import keys…"
msgstr "Импорт ключей…"

#: btsync/gui.py
msgid "The file contains secret keys: keep it private."
msgstr "Файл содержит секретные ключи: никому его не передавайте."

#: btsync/gui.py
msgid "Bluetooth devices"
msgstr "Устройства Bluetooth"

#: btsync/gui.py
msgid "Refresh"
msgstr "Обновить"

#: btsync/gui.py
msgid "Rescan both systems now"
msgstr "Пересканировать обе системы сейчас"

#: btsync/gui.py
msgid "Enable now"
msgstr "Включить"

#: btsync/gui.py
msgid "✔ in sync     → only on one system     ⚠ different keys (★ = newer key)"
msgstr ""
"✔ синхронизировано     → только в одной системе     ⚠ разные ключи (★ = "
"более новый ключ)"

#: btsync/gui.py
msgid "Archive: never sync these and don't notify me"
msgstr "Архив: не синхронизировать эти устройства и не уведомлять"

#: btsync/gui.py
msgid "Archive selected ↓"
msgstr "Архивировать выбранные ↓"

#: btsync/gui.py
msgid "↑ Restore selected"
msgstr "↑ Вернуть выбранные"

#: btsync/gui.py
msgid "Enjoying bt-sync? Buy me a 1UP!"
msgstr "Нравится bt-sync? Подарите мне 1UP!"

#: btsync/gui.py
msgid "Support me ☕"
msgstr "Поддержать ☕"

#: btsync/gui.py
msgid "to Windows"
msgstr "в Windows"

#: btsync/gui.py
#, python-brace-format
msgid "to {system}"
msgstr "в {system}"

#: btsync/gui.py
#, python-brace-format
msgid "Copy the selected devices from {system} to Windows"
msgstr "Скопировать выбранные устройства из {system} в Windows"

#: btsync/gui.py
#, python-brace-format
msgid "Copy the selected devices from Windows to {system}"
msgstr "Скопировать выбранные устройства из Windows в {system}"

#: btsync/gui.py
msgid "Open Bluetooth Sync"
msgstr "Открыть Bluetooth Sync"

#: btsync/gui.py
msgid "Refresh now"
msgstr "Обновить сейчас"

#: btsync/gui.py
msgid "Settings…"
msgstr "Настройки…"

#: btsync/gui.py
msgid "Quit"
msgstr "Выход"

#: btsync/gui.py
msgid ""
"The background scan is not enabled, so the device lists are not updated."
msgstr ""
"Фоновое сканирование не включено, поэтому списки устройств не обновляются."

#: btsync/gui.py
msgid "Cannot change the login autostart:"
msgstr "Не удалось изменить автозапуск при входе:"

#: btsync/gui.py
#, python-brace-format
msgid "Could not open the browser: {url}"
msgstr "Не удалось открыть браузер: {url}"

#: btsync/gui.py
msgid "No scan available yet"
msgstr "Сканирований пока нет"

#: btsync/gui.py
msgid ""
"The background scan has not run yet. If this persists, make sure it is "
"enabled:"
msgstr ""
"Фоновое сканирование ещё не запускалось. Если так и останется, проверьте, "
"что оно включено:"

#: btsync/gui.py
#, python-brace-format
msgid "{n} device to sync"
msgid_plural "{n} devices to sync"
msgstr[0] "{n} устройство для синхронизации"
msgstr[1] "{n} устройства для синхронизации"
msgstr[2] "{n} устройств для синхронизации"

#: btsync/gui.py
msgid "everything in sync"
msgstr "всё синхронизировано"

#: btsync/gui.py
#, python-brace-format
msgid "To sync: {devices}"
msgstr "Нужно синхронизировать: {devices}"

#: btsync/gui.py
msgid "different keys"
msgstr "разные ключи"

#: btsync/gui.py
msgid "newer key"
msgstr "более новый ключ"

#: btsync/gui.py
msgid "older key"
msgstr "более старый ключ"

#: btsync/gui.py
#, python-brace-format
msgid "{kind} key changed on Windows: {wtime}, on {system}: {ltime}"
msgstr "Ключ {kind} изменён в Windows: {wtime}, в {system}: {ltime}"

#: btsync/gui.py
msgid ""
"Cannot tell which key is newer: copy from the system where you paired the "
"device last."
msgstr ""
"Невозможно определить, какой ключ новее: копируйте из системы, в которой "
"устройство было сопряжено последним."

#: btsync/gui.py
msgid "only here"
msgstr "только здесь"

#: btsync/gui.py
msgid "partially synced"
msgstr "синхронизировано частично"

#: btsync/gui.py
msgid "in sync"
msgstr "синхронизировано"

#: btsync/gui.py
msgid "Could not read Windows:"
msgstr "Не удалось прочитать Windows:"

#: btsync/gui.py
msgid ""
"Linux and Windows use different Bluetooth adapters (different adapter "
"addresses): nothing can be synced."
msgstr ""
"Linux и Windows используют разные адаптеры Bluetooth (разные адреса "
"адаптера): синхронизировать нечего."

#: btsync/gui.py
#, python-brace-format
msgid "Last scan: {time}"
msgstr "Последнее сканирование: {time}"

#: btsync/gui.py
#, python-brace-format
msgid ""
"{devices}: the key on {system} is newer. You probably want to copy in the "
"other direction."
msgstr ""
"{devices}: ключ в {system} новее. Вероятно, копировать нужно в обратном "
"направлении."

#: btsync/gui.py
msgid "The selected key is the newer one: copying it is probably right."
msgstr "Выбранный ключ новее: скорее всего, копировать нужно именно его."

#: btsync/gui.py
msgid "Cannot start a scan"
msgstr "Не удаётся запустить сканирование"

#: btsync/gui.py
#, python-brace-format
msgid "Cannot request a scan ({error}). Try:"
msgstr "Не удаётся запросить сканирование ({error}). Попробуйте:"

#: btsync/gui.py
msgid "Scanning…"
msgstr "Сканирование…"

#: btsync/gui.py
msgid "The scan did not answer"
msgstr "Сканирование не ответило"

#: btsync/gui.py
msgid "The scan service did not answer. Make sure it is enabled:"
msgstr "Служба сканирования не ответила. Проверьте, что она включена:"

#: btsync/gui.py
msgid ""
"Could not start pkexec. Is polkit installed and is a polkit authentication "
"agent running?"
msgstr ""
"Не удалось запустить pkexec. Установлен ли polkit и запущен ли агент "
"аутентификации polkit?"

#: btsync/gui.py
msgid "Authentication cancelled or not authorized"
msgstr "Аутентификация отменена или не разрешена"

#: btsync/gui.py
#, python-brace-format
msgid "Unexpected answer from {helper} (exit code {code})."
msgstr "Неожиданный ответ от {helper} (код выхода {code})."

#: btsync/gui.py
msgid "Working…"
msgstr "Выполняется…"

#: btsync/gui.py
#, python-brace-format
msgid ""
"The keys of {devices} differ between the two systems.\n"
"The ones on {system} will be overwritten."
msgstr ""
"Ключи {devices} в двух системах различаются.\n"
"Ключи в {system} будут перезаписаны."

#: btsync/gui.py
#, python-brace-format
msgid ""
"Careful: for {devices} the key you are about to overwrite is the newer one."
msgstr "Осторожно: для {devices} ключ, который вы перезапишете, новее."

#: btsync/gui.py
msgid "Overwrite the keys?"
msgstr "Перезаписать ключи?"

#: btsync/gui.py
msgid "Continue?"
msgstr "Продолжить?"

#: btsync/gui.py
msgid "Done:"
msgstr "Готово:"

#: btsync/gui.py
msgid "Problems:"
msgstr "Проблемы:"

#: btsync/gui.py
msgid "Export pairing keys"
msgstr "Экспорт ключей сопряжения"

#: btsync/gui.py
msgid "bt-sync key backup"
msgstr "Резервная копия ключей bt-sync"

#: btsync/gui.py
#, python-brace-format
msgid "Cannot write {path}: {error}"
msgstr "Не удаётся записать {path}: {error}"

#: btsync/gui.py
#, python-brace-format
msgid "Exported {n} pairing key to:"
msgid_plural "Exported {n} pairing keys to:"
msgstr[0] "Экспортирован {n} ключ сопряжения в:"
msgstr[1] "Экспортировано {n} ключа сопряжения в:"
msgstr[2] "Экспортировано {n} ключей сопряжения в:"

#: btsync/gui.py
msgid "Import pairing keys"
msgstr "Импорт ключей сопряжения"

#: btsync/gui.py
msgid "This is not a valid bt-sync key backup file."
msgstr "Это не корректный файл резервной копии ключей bt-sync."

#: btsync/gui.py
#, python-brace-format
msgid "Skipped: these Bluetooth adapters are not on this computer: {list}"
msgstr "Пропущено: этих адаптеров Bluetooth нет на этом компьютере: {list}"

#: btsync/gui.py
#, python-brace-format
msgid "Nothing to import: the {n} key in the file is already present."
msgid_plural "Nothing to import: the {n} keys in the file are already present."
msgstr[0] "Нечего импортировать: {n} ключ из файла уже есть."
msgstr[1] "Нечего импортировать: {n} ключа из файла уже есть."
msgstr[2] "Нечего импортировать: {n} ключей из файла уже есть."

#: btsync/gui.py
#, python-brace-format
msgid "{n} new key will be imported:"
msgid_plural "{n} new keys will be imported:"
