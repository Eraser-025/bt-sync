#, python-brace-format
msgid "{n} key is different from the one on this computer:"
msgid_plural "{n} keys are different from the ones on this computer:"
msgstr[0] "{n} ключ отличается от ключа на этом компьютере:"
msgstr[1] "{n} ключа отличаются от ключей на этом компьютере:"
msgstr[2] "{n} ключей отличаются от ключей на этом компьютере:"

#: btsync/gui.py
msgid "Bluetooth will restart for a moment."
msgstr "Bluetooth ненадолго перезапустится."

#: btsync/gui.py
msgid "Import new keys only"
msgstr "Импортировать только новые ключи"

#: btsync/gui.py
msgid "Import and overwrite"
msgstr "Импортировать и перезаписать"
