#: btsync/backend.py
msgid ""
"This usually means Windows was hibernated or Fast Startup is enabled: in "
"Windows run 'powercfg /h off' from an administrator prompt, then use Shut "
"down (not Restart) before booting Linux."
msgstr ""
"Normalmente isso significa que o Windows foi hibernado ou que a "
"inicialização rápida está ativada: no Windows, execute 'powercfg /h off' em "
"um prompt de administrador e use Desligar (não Reiniciar) antes de iniciar o "
"Linux."

#: btsync/backend.py
#, python-brace-format
msgid "unexpected error: {error}"
msgstr "erro inesperado: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: warning: {message}"
msgstr "bt-sync: aviso: {message}"

#: btsync/backend.py
#, python-brace-format
msgid "ignoring invalid {path}: {error}"
msgstr "ignorando {path} inválido: {error}"

#: btsync/backend.py
msgid "this command must be run as root (try: sudo bt-sync ...)."
msgstr ""
"este comando precisa ser executado como root (tente: sudo bt-sync ...)."

#: btsync/backend.py
msgid "another bt-sync operation is still running; try again in a minute."
msgstr ""
"outra operação do bt-sync ainda está em andamento; tente novamente em um "
"minuto."

#: btsync/backend.py
#, python-brace-format
msgid "lsblk failed: {error}"
msgstr "lsblk falhou: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "Windows partition not found: no NTFS partition contains {path}."
msgstr ""
"Partição do Windows não encontrada: nenhuma partição NTFS contém {path}."

#: btsync/backend.py
msgid ""
"A BitLocker-encrypted partition was detected: bt-sync cannot read it. Turn "
"off BitLocker (or device encryption) on the Windows system drive."
msgstr ""
"Foi detectada uma partição criptografada com BitLocker: o bt-sync não "
"consegue lê-la. Desative o BitLocker (ou a criptografia do dispositivo) na "
"unidade do sistema do Windows."

#: btsync/backend.py
msgid "No NTFS partitions were detected at all."
msgstr "Nenhuma partição NTFS foi detectada."

#: btsync/backend.py
#, python-brace-format
msgid "Some NTFS partitions could not be mounted ({errors})."
msgstr "Algumas partições NTFS não puderam ser montadas ({errors})."

#: btsync/backend.py
msgid ""
"the Python bindings of hivex are missing: install 'hivex' (Arch) or 'python3-"
"hivex' (Debian, Ubuntu, Fedora)."
msgstr ""
"faltam as ligações Python do hivex: instale 'hivex' (Arch) ou 'python3-"
"hivex' (Debian, Ubuntu, Fedora)."

#: btsync/backend.py
#, python-brace-format
msgid "cannot open the Windows registry {path}: {error}"
msgstr "não foi possível abrir o registro do Windows {path}: {error}"

#: btsync/backend.py
msgid ""
"unexpected Windows registry layout (SYSTEM\\Select\\Current is missing)."
msgstr ""
"estrutura inesperada do registro do Windows (SYSTEM\\Select\\Current não "
"existe)."

#: btsync/backend.py
#, python-brace-format
msgid ""
"Windows registry key not found: {key}. Has Bluetooth ever been used on this "
"Windows install?"
msgstr ""
"Chave do registro do Windows não encontrada: {key}. O Bluetooth já foi usado "
"nesta instalação do Windows?"

#: btsync/backend.py
msgid ""
"no Bluetooth pairing keys in the Windows registry (pair at least one device "
"in Windows first)."
msgstr ""
"não há chaves de pareamento Bluetooth no registro do Windows (pareie pelo "
"menos um dispositivo no Windows primeiro)."

#: btsync/backend.py
#, python-brace-format
msgid "Bluetooth adapter {adapter} is not in the Windows registry."
msgstr "O adaptador Bluetooth {adapter} não está no registro do Windows."

#: btsync/backend.py
#, python-brace-format
msgid "writing the Windows registry failed: {error}"
msgstr "falha ao gravar o registro do Windows: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "skipping unreadable {path}: {error}"
msgstr "ignorando {path} ilegível: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "could not stop bluetooth.service: {error}"
msgstr "não foi possível parar o bluetooth.service: {error}"

#: btsync/backend.py
#, python-brace-format
msgid ""
"could not restart bluetooth.service, run 'sudo systemctl start bluetooth': "
"{error}"
msgstr ""
"não foi possível reiniciar o bluetooth.service, execute 'sudo systemctl "
"start bluetooth': {error}"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: scan failed: {error}"
msgstr "bt-sync: a verificação falhou: {error}"

#: btsync/backend.py
#, python-brace-format
msgid "imported into {system}: {device} ({kind})"
msgstr "importado para o {system}: {device} ({kind})"

#: btsync/backend.py
#, python-brace-format
msgid "exported to Windows: {device} ({kind})"
msgstr "exportado para o Windows: {device} ({kind})"

#: btsync/backend.py
msgid "Windows is mounted read-only."
msgstr "O Windows está montado somente para leitura."

#: btsync/backend.py
#, python-brace-format
msgid "Windows is mounted read-only (it is already mounted at {path})."
msgstr ""
"O Windows está montado somente para leitura (já está montado em {path})."

#: btsync/backend.py
#, python-brace-format
msgid "could not enable the background scan: {error}"
msgstr "não foi possível ativar a verificação em segundo plano: {error}"

#: btsync/backend.py btsync/gui.py
msgid "Background scan enabled."
msgstr "Verificação em segundo plano ativada."

#: btsync/backend.py
msgid "bt-sync: another operation is running, scan skipped."
msgstr "bt-sync: outra operação está em andamento, verificação ignorada."

#: btsync/backend.py
msgid "Scan completed."
msgstr "Verificação concluída."

#: btsync/backend.py
msgid "Scan completed with errors."
msgstr "Verificação concluída com erros."

#: btsync/backend.py
msgid "invalid request from the GUI."
msgstr "solicitação inválida da interface."

#: btsync/backend.py
#, python-brace-format
msgid "{device}: nothing to copy in that direction (already in sync?)."
msgstr "{device}: nada para copiar nessa direção (já sincronizado?)."

#: btsync/backend.py
#, python-brace-format
msgid "{device}: not paired on {system}."
msgstr "{device}: não está pareado no {system}."

#: btsync/backend.py
#, python-brace-format
msgid "removed from {system}: {device}"
msgstr "removido do {system}: {device}"

#: btsync/backend.py
#, python-brace-format
msgid "invalid Bluetooth address: {mac}"
msgstr "endereço Bluetooth inválido: {mac}"

#: btsync/backend.py
#, python-brace-format
msgid "Delete the pairing of {devices} from {system}? [y/N] "
msgstr "Excluir o pareamento de {devices} do {system}? [s/N] "

#: btsync/backend.py
msgid "Nothing was deleted."
msgstr "Nada foi excluído."

#: btsync/backend.py
#, python-brace-format
msgid "backup of the Windows registry saved to {path}"
msgstr "backup do registro do Windows salvo em {path}"

#: btsync/backend.py
#, python-brace-format
msgid "error: {message}"
msgstr "erro: {message}"

#: btsync/backend.py
msgid "the output contains secret pairing keys: keep it private."
msgstr "a saída contém chaves de pareamento secretas: não a compartilhe."

#: btsync/backend.py
msgid "this is not a valid bt-sync key backup file."
msgstr "este não é um arquivo de backup de chaves do bt-sync válido."

#: btsync/backend.py
#, python-brace-format
msgid "Adapters not present on this computer (skipped): {list}"
msgstr "Adaptadores ausentes neste computador (ignorados): {list}"

#: btsync/backend.py
#, python-brace-format
msgid "Already present: {n}"
msgstr "Já presentes: {n}"

#: btsync/backend.py
msgid "New"
msgstr "Nova"

#: btsync/backend.py
msgid "Different from this computer"
msgstr "Diferente deste computador"

#: btsync/backend.py
msgid "Dry run: nothing was changed."
msgstr "Simulação: nada foi alterado."

#: btsync/backend.py
msgid "Keys that differ were kept; use --overwrite to replace them."
msgstr ""
"As chaves diferentes foram mantidas; use --overwrite para substituí-las."

#: btsync/backend.py
#, python-brace-format
msgid "on Windows, missing on {system}"
msgstr "no Windows, ausente no {system}"

#: btsync/backend.py
#, python-brace-format
msgid "on {system}, missing on Windows"
msgstr "no {system}, ausente no Windows"

#: btsync/backend.py
msgid "DIFFERENT keys on the two systems"
msgstr "chaves DIFERENTES nos dois sistemas"

#: btsync/backend.py
msgid "the Windows key is newer"
msgstr "a chave do Windows é mais recente"

#: btsync/backend.py
#, python-brace-format
msgid "the {system} key is newer"
msgstr "a chave do {system} é mais recente"

#: btsync/backend.py
msgid "Everything is in sync."
msgstr "Tudo está sincronizado."

#: btsync/backend.py
msgid "skip"
msgstr "pular"

#: btsync/backend.py
msgid "ignore from now on"
msgstr "ignorar daqui em diante"

#: btsync/backend.py
#, python-brace-format
msgid "import into {system}"
msgstr "importar para o {system}"

#: btsync/backend.py
msgid "export to Windows"
msgstr "exportar para o Windows"

#: btsync/backend.py
msgid "(Windows is mounted read-only: cannot export)"
msgstr "(o Windows está montado somente para leitura: não é possível exportar)"

#: btsync/backend.py
#, python-brace-format
msgid "bt-sync: error: {message}"
msgstr "bt-sync: erro: {message}"

#: btsync/backend.py
msgid "Aborted, nothing was changed."
msgstr "Cancelado, nada foi alterado."

#: btsync/gui.py
msgid "Settings"
msgstr "Configurações"

#: btsync/gui.py
msgid "General"
msgstr "Geral"

#: btsync/gui.py
#, python-brace-format
msgid "System default ({language})"
msgstr "Padrão do sistema ({language})"

#: btsync/gui.py
msgid "Language:"
msgstr "Idioma:"

#: btsync/gui.py
msgid "Start in tray at login"
msgstr "Iniciar na bandeja ao entrar"

#: btsync/gui.py
msgid "No system tray available on this desktop"
msgstr "Não há bandeja do sistema neste ambiente"

#: btsync/gui.py
msgid "Show desktop notifications"
msgstr "Mostrar notificações na área de trabalho"

#: btsync/gui.py
msgid "Pairing keys backup"
msgstr "Backup das chaves de pareamento"

#: btsync/gui.py
msgid ""
"Save the pairing keys of this Linux system to a file and restore them later, "
"for example after reinstalling Linux or on another Linux system installed on "
"this computer."
msgstr ""
"Salve as chaves de pareamento deste sistema Linux em um arquivo e restaure-"
"as depois, por exemplo após reinstalar o Linux ou em outro sistema Linux "
"instalado neste computador."

#: btsync/gui.py
msgid "Export keys…"
msgstr "Exportar chaves…"

#: btsync/gui.py
msgid "Import keys…"
msgstr "Importar chaves…"

#: btsync/gui.py
msgid "The file contains secret keys: keep it private."
msgstr "O arquivo contém chaves secretas: não o compartilhe."

#: btsync/gui.py
msgid "Bluetooth devices"
msgstr "Dispositivos Bluetooth"

#: btsync/gui.py
msgid "Refresh"
msgstr "Atualizar"

#: btsync/gui.py
msgid "Rescan both systems now"
msgstr "Verificar os dois sistemas agora"

#: btsync/gui.py
msgid "Enable now"
msgstr "Ativar agora"

#: btsync/gui.py
msgid "✔ in sync     → only on one system     ⚠ different keys (★ = newer key)"
msgstr ""
"✔ sincronizado     → só em um sistema     ⚠ chaves diferentes (★ = chave "
"mais recente)"

#: btsync/gui.py
msgid "Archive: never sync these and don't notify me"
msgstr "Arquivo: nunca sincronizar estes nem me avisar"

#: btsync/gui.py
msgid "Archive selected ↓"
msgstr "Arquivar selecionados ↓"

#: btsync/gui.py
msgid "↑ Restore selected"
msgstr "↑ Restaurar selecionados"

#: btsync/gui.py
msgid "Enjoying bt-sync? Buy me a 1UP!"
msgstr "Curtindo o bt-sync? Me pague um 1UP!"

#: btsync/gui.py
msgid "Support me ☕"
msgstr "Me apoie ☕"

#: btsync/gui.py
msgid "Delete…"
msgstr "Excluir…"

#: btsync/gui.py
msgid "to Windows"
msgstr "para o Windows"

#: btsync/gui.py
#, python-brace-format
msgid "to {system}"
msgstr "para o {system}"

#: btsync/gui.py
#, python-brace-format
msgid "Copy the selected devices from {system} to Windows"
msgstr "Copiar os dispositivos selecionados do {system} para o Windows"

#: btsync/gui.py
#, python-brace-format
msgid "Copy the selected devices from Windows to {system}"
msgstr "Copiar os dispositivos selecionados do Windows para o {system}"

#: btsync/gui.py
#, python-brace-format
msgid "Delete the pairing of the selected devices from {system}"
msgstr "Excluir o pareamento dos dispositivos selecionados do {system}"

#: btsync/gui.py
msgid "Open Bluetooth Sync"
msgstr "Abrir o Bluetooth Sync"

#: btsync/gui.py
msgid "Refresh now"
msgstr "Atualizar agora"

#: btsync/gui.py
msgid "Settings…"
msgstr "Configurações…"

#: btsync/gui.py
msgid "Quit"
msgstr "Sair"

#: btsync/gui.py
msgid ""
"The background scan is not enabled, so the device lists are not updated."
msgstr ""
"A verificação em segundo plano não está ativada, então as listas de "
"dispositivos não são atualizadas."

#: btsync/gui.py
msgid "Cannot change the login autostart:"
msgstr "Não foi possível alterar a inicialização automática:"

#: btsync/gui.py
#, python-brace-format
msgid "Could not open the browser: {url}"
msgstr "Não foi possível abrir o navegador: {url}"

#: btsync/gui.py
msgid "No scan available yet"
msgstr "Nenhuma verificação disponível ainda"

#: btsync/gui.py
msgid ""
"The background scan has not run yet. If this persists, make sure it is "
"enabled:"
msgstr ""
"A verificação em segundo plano ainda não foi executada. Se isso continuar, "
"verifique se ela está ativada:"

#: btsync/gui.py
#, python-brace-format
msgid "{n} device to sync"
msgid_plural "{n} devices to sync"
msgstr[0] "{n} dispositivo para sincronizar"
msgstr[1] "{n} dispositivos para sincronizar"

#: btsync/gui.py
msgid "everything in sync"
msgstr "tudo sincronizado"

#: btsync/gui.py
#, python-brace-format
msgid "To sync: {devices}"
msgstr "Para sincronizar: {devices}"

#: btsync/gui.py
msgid "different keys"
msgstr "chaves diferentes"

#: btsync/gui.py
msgid "newer key"
msgstr "chave mais recente"

#: btsync/gui.py
msgid "older key"
msgstr "chave mais antiga"

#: btsync/gui.py
#, python-brace-format
msgid "{kind} key changed on Windows: {wtime}, on {system}: {ltime}"
msgstr "Chave {kind} alterada no Windows: {wtime}, no {system}: {ltime}"

#: btsync/gui.py
msgid ""
"Cannot tell which key is newer: copy from the system where you paired the "
"device last."
msgstr ""
"Não é possível saber qual chave é mais recente: copie do sistema em que você "
"pareou o dispositivo por último."

#: btsync/gui.py
msgid "only here"
msgstr "só aqui"

#: btsync/gui.py
msgid "partially synced"
msgstr "sincronizado em parte"

#: btsync/gui.py
msgid "in sync"
msgstr "sincronizado"

#: btsync/gui.py
msgid "Could not read Windows:"
msgstr "Não foi possível ler o Windows:"

#: btsync/gui.py
msgid ""
"Linux and Windows use different Bluetooth adapters (different adapter "
"addresses): nothing can be synced."
msgstr ""
"O Linux e o Windows usam adaptadores Bluetooth diferentes (endereços de "
"adaptador diferentes): nada pode ser sincronizado."

#: btsync/gui.py
#, python-brace-format
msgid "Last scan: {time}"
msgstr "Última verificação: {time}"

#: btsync/gui.py
#, python-brace-format
msgid ""
"{devices}: the key on {system} is newer. You probably want to copy in the "
"other direction."
msgstr ""
"{devices}: a chave no {system} é mais recente. Provavelmente você quer "
"copiar na outra direção."

#: btsync/gui.py
msgid "The selected key is the newer one: copying it is probably right."
msgstr ""
"A chave selecionada é a mais recente: copiá-la provavelmente é o certo."

#: btsync/gui.py
msgid "Cannot start a scan"
msgstr "Não foi possível iniciar a verificação"

#: btsync/gui.py
#, python-brace-format
msgid "Cannot request a scan ({error}). Try:"
msgstr "Não foi possível solicitar uma verificação ({error}). Tente:"

#: btsync/gui.py
msgid "Scanning…"
msgstr "Verificando…"

#: btsync/gui.py
msgid "The scan did not answer"
msgstr "A verificação não respondeu"

#: btsync/gui.py
msgid "The scan service did not answer. Make sure it is enabled:"
msgstr "O serviço de verificação não respondeu. Verifique se ele está ativado:"

#: btsync/gui.py
msgid ""
"Could not start pkexec. Is polkit installed and is a polkit authentication "
"agent running?"
msgstr ""
"Não foi possível iniciar o pkexec. O polkit está instalado e há um agente de "
"autenticação do polkit em execução?"

#: btsync/gui.py
msgid "Authentication cancelled or not authorized"
msgstr "Autenticação cancelada ou não autorizada"

#: btsync/gui.py
#, python-brace-format
msgid "Unexpected answer from {helper} (exit code {code})."
msgstr "Resposta inesperada de {helper} (código de saída {code})."

#: btsync/gui.py
msgid "Working…"
msgstr "Processando…"

#: btsync/gui.py
#, python-brace-format
msgid ""
"The keys of {devices} differ between the two systems.\n"
"The ones on {system} will be overwritten."
msgstr ""
"As chaves de {devices} são diferentes nos dois sistemas.\n"
"As do {system} serão substituídas."

#: btsync/gui.py
#, python-brace-format
msgid ""
"Careful: for {devices} the key you are about to overwrite is the newer one."
msgstr ""
"Cuidado: para {devices}, a chave que você vai substituir é a mais recente."

#: btsync/gui.py
msgid "Overwrite the keys?"
msgstr "Substituir as chaves?"

#: btsync/gui.py
msgid "Continue?"
msgstr "Continuar?"

#: btsync/gui.py
#, python-brace-format
msgid ""
"The pairing keys of {devices} will be deleted from {system}. The device will "
"have to be paired again there, or you can copy the key from the other system."
msgstr ""
"As chaves de pareamento de {devices} serão excluídas do {system}. Será "
"preciso parear o dispositivo de novo lá, ou você pode copiar a chave do "
"outro sistema."

#: btsync/gui.py
msgid ""
"Windows may still list the device in its Bluetooth settings: remove it there "
"too if needed. A backup of the Windows registry is made first."
msgstr ""
"O Windows pode continuar mostrando o dispositivo nas configurações de "
"Bluetooth: se precisar, remova-o lá também. Antes é feito um backup do "
"registro do Windows."

#: btsync/gui.py
msgid "Bluetooth will restart for a moment."
msgstr "O Bluetooth será reiniciado por um instante."

#: btsync/gui.py
msgid "Delete the pairing?"
msgstr "Excluir o pareamento?"

#: btsync/gui.py
msgid "Delete"
msgstr "Excluir"

#: btsync/gui.py
msgid "Done:"
msgstr "Concluído:"

#: btsync/gui.py
msgid "Problems:"
msgstr "Problemas:"

#: btsync/gui.py
msgid "Export pairing keys"
msgstr "Exportar chaves de pareamento"

#: btsync/gui.py
msgid "bt-sync key backup"
msgstr "Backup de chaves do bt-sync"

#: btsync/gui.py
#, python-brace-format
msgid "Cannot write {path}: {error}"
msgstr "Não foi possível gravar {path}: {error}"

#: btsync/gui.py
#, python-brace-format
msgid "Exported {n} pairing key to:"
msgid_plural "Exported {n} pairing keys to:"
msgstr[0] "{n} chave de pareamento exportada para:"
msgstr[1] "{n} chaves de pareamento exportadas para:"

#: btsync/gui.py
msgid "Import pairing keys"
msgstr "Importar chaves de pareamento"

#: btsync/gui.py
msgid "This is not a valid bt-sync key backup file."
msgstr "Este não é um arquivo de backup de chaves do bt-sync válido."

#: btsync/gui.py
#, python-brace-format
msgid "Skipped: these Bluetooth adapters are not on this computer: {list}"
msgstr ""
"Ignorados: estes adaptadores Bluetooth não estão neste computador: {list}"

#: btsync/gui.py
#, python-brace-format
msgid "Nothing to import: the {n} key in the file is already present."
msgid_plural "Nothing to import: the {n} keys in the file are already present."
msgstr[0] "Nada para importar: a {n} chave do arquivo já está presente."
msgstr[1] "Nada para importar: as {n} chaves do arquivo já estão presentes."

#: btsync/gui.py
#, python-brace-format
msgid "{n} new key will be imported:"
msgid_plural "{n} new keys will be imported:"
msgstr[0] "{n} chave nova será importada:"
msgstr[1] "{n} chaves novas serão importadas:"

#: btsync/gui.py
#, python-brace-format
msgid "{n} key is different from the one on this computer:"
msgid_plural "{n} keys are different from the ones on this computer:"
msgstr[0] "{n} chave é diferente da deste computador:"
msgstr[1] "{n} chaves são diferentes das deste computador:"

#: btsync/gui.py
msgid "Import new keys only"
msgstr "Importar só as chaves novas"

#: btsync/gui.py
msgid "Import and overwrite"
msgstr "Importar e substituir"
