[Unit]
Description=bt-sync: compare Bluetooth pairing keys between Linux and Windows
Documentation=https://github.com/Eraser-025/bt-sync
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bt-sync scan
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
